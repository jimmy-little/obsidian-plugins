{
	"name": "obsidian-plugin-agent-control",
	"version": "0.1.0",
	"description": "Agent Control Center dashboard inside Obsidian",
	"main": "main.js",
	"scripts": {
		"prebuild": "node ../../tooling/merge-css.mjs",
		"dev": "node esbuild.config.mjs",
		"build": "tsc -p tsconfig.json --noEmit && node esbuild.config.mjs production",
		"build:install": "npm run build && node ../../tooling/install-to-vault.mjs .",
		"test": "vitest run"
	},
	"keywords": ["obsidian", "obsidian-plugin"],
	"author": "Jimmy Little",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.18.0",
		"esbuild": "^0.27.0",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "^5.6.0",
		"vitest": "^4.1.8"
	}
}
